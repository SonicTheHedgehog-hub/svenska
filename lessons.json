   {"who": "Säljaren", "t": [["Tack", "danke"], ["så", "so"], ["mycket!", "viel!"], ["Fem", "fünf"], ["kronor", "Kronen"], ["tillbaka.", "zurück."]], "sense": "Vielen Dank! Fünf Kronen zurück."}
