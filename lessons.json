   {"who": "Karin", "t": [["Ja,", "ja,"], ["och", "und"], ["där", "dort"], ["är", "ist"], ["ett", "ein"], ["får.", "Schaf."]], "sense": "Ja, und da ist ein Schaf."},
   {"who": "Janina", "t": [["Hästen", "Pferd-das"], ["är", "ist"], ["brun", "braun"], ["och", "und"], ["fåret", "Schaf-das"], ["är", "ist"], ["vitt.", "weiß."]], "sense": "Das Pferd ist braun und das Schaf ist weiß."},
