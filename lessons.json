   {"who": "Säljaren", "t": [["Fem", "fünf"], ["äpplen,", "Äpfel,"], ["det", "es"], ["blir", "wird"], ["femton", "fünfzehn"], ["kronor.", "Kronen."]], "sense": "Fünf Äpfel, das macht fünfzehn Kronen."},
