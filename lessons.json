  "chunks": [["Ursäkta!", "Entschuldigung!"], ["Hur mycket kostar det?", "Wie viel kostet das?"], ["Tre kronor styck.", "Drei Kronen das Stück."], ["Då tar jag fem.", "Dann nehme ich fünf."], ["Det blir femton kronor.", "Das macht fünfzehn Kronen."], ["Tack så mycket!", "Vielen Dank!"], ["ett, två, tre, fyra, fem", "eins, zwei, drei, vier, fünf"], ["sex, sju, åtta, nio, tio", "sechs, sieben, acht, neun, zehn"]],
